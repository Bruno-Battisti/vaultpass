# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vaultpass
DB_USER=vaultpass
DB_PASSWORD=change-me

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev

# --- JWT signing key ---
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-32-byte-base64-secret

# --- AES-256 key for vault passwords and 2FA secrets ---
# Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
